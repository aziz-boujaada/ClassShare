# Browser-safe Supabase project configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-side settings: configure these as Supabase Edge Function secrets,
# never as VITE_* variables and never in the browser .env file.
# GROQ_API_KEY=your-groq-api-key
# GROQ_MODEL=openai/gpt-oss-20b
# MAX_PDF_SIZE_MB=30
# MAX_PDF_PAGES=80
# MAX_GENERATION_TOKENS=6000
# AI_GENERATION_TIMEOUT_MS=45000
# APP_ORIGIN=https://your-classshare-domain.example
