# Browser-safe Supabase project configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-side settings: configure these as Supabase Edge Function secrets,
# never as VITE_* variables and never in the browser .env file.
# GROQ_API_KEY=your-groq-api-key
# GROQ_MODEL=qwen/qwen3.8-27b
# MAX_PDF_SIZE_MB=30
# MAX_PDF_PAGES=50
# MAX_SOURCE_CHARS=100000
# MAX_GENERATION_TOKENS=6000
# AI_GENERATION_TIMEOUT_MS=45000
# MAX_CONCURRENT_GENERATIONS_PER_USER=1
# APP_ORIGIN=https://your-classshare-domain.example
# Optional: defaults to the public Judge0 CE endpoint.
# JUDGE0_URL=https://ce.judge0.com
# Optional custom mapping: JUDGE0_LANGUAGE_IDS={"java":91,"python":71,"javascript":63,"typescript":74}
